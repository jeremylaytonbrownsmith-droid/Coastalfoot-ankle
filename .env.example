# Copy to .env.local and fill in. All values are optional in development.

# Which site config to build (matches a key in lib/site-config.ts).
# Defaults to coastal-foot-ankle when unset.
SITE_CONFIG=coastal-foot-ankle

# Email delivery for the callback form (https://resend.com).
# Without these, form submissions are logged to the server console instead.
RESEND_API_KEY=
STAFF_NOTIFICATION_EMAIL=
NOTIFICATION_FROM_EMAIL=

# Future Halo Health intake webhook — see app/api/callback/route.ts.
# Intentionally unused today.
# HALO_INTAKE_WEBHOOK_URL=
